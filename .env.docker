# ============================================================
# Docker Compose 环境变量
# 复制此文件为 .env.docker.local 并填入真实密钥
# ============================================================

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=jiaoyu

# 后端 — 数据库（注意 host 填写 docker-compose 服务名 mysql）
DATABASE_URL=mysql://root:root@mysql:3306/jiaoyu

# 后端 — 端口
PORT=3000
NODE_ENV=production

# 后端 — CORS（生产环境填写前端实际域名）
CORS_ORIGIN=*

# 后端 — 管理端 Token
ADMIN_TOKEN=change-me-to-a-strong-secret

# 后端 — JWT 密钥
JWT_SECRET=change-me-to-a-strong-jwt-secret

# 后端 — AI 服务
OPENAI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=deepseek-ai/DeepSeek-V3
