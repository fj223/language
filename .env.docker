# ============================================================
# Docker Compose 环境变量
# 复制此文件为 .env.docker.local 并填入真实密钥
# ============================================================

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=jiaoyu

# 后端 — 数据库（注意 host 填写 docker-compose 服务名 mysql）
DATABASE_URL=mysql://root:root@mysql:3306/jiaoyu

# 后端 — 端口
PORT=3000
NODE_ENV=production

# 后端 — CORS（生产环境填写前端实际域名）
CORS_ORIGIN=*

# 后端 — 管理员会话与初始账号（仅本地论文演示）
ADMIN_JWT_SECRET=change-me-to-a-strong-admin-jwt-secret
ADMIN_BOOTSTRAP_EMAIL=admin@openedu.local
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-password
ADMIN_BOOTSTRAP_NAME=系统管理员

# 后端 — JWT 密钥
JWT_SECRET=change-me-to-a-strong-jwt-secret

# 后端 — AI 服务
AI_ENABLED=false
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# 教务数据集成（上线时切换为 external 并填写机构接口地址）
EDU_DATA_PROVIDER=mock
EDU_API_BASE_URL=
EDU_API_KEY=
EDU_API_TIMEOUT_MS=8000
EDU_API_RETRY_COUNT=1
