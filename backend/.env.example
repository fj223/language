# ============================================================
# 数据库配置
# ============================================================
DATABASE_URL="mysql://root:root@localhost:3306/jiaoyu"

# ============================================================
# 服务端配置
# ============================================================
PORT=3000
NODE_ENV="development"

# 跨域白名单，多个地址用逗号分隔，* 表示允许所有
CORS_ORIGIN="http://localhost:5173"

# ============================================================
# 安全鉴权（管理端接口使用）
# ============================================================
ADMIN_TOKEN="change-me-to-a-strong-secret"

# ============================================================
# AI 服务配置
# 支持任何兼容 OpenAI Chat Completions 格式的服务商
# ============================================================

# API 密钥（必填）
# - 硅基流动：在 https://cloud.siliconflow.cn 注册后获取
# - OpenAI 官方：在 https://platform.openai.com/api-keys 获取
# - DeepSeek 官方：在 https://platform.deepseek.com 获取
OPENAI_API_KEY="sk-your-api-key-here"

# API Base URL（必填）
# - 硅基流动（推荐，国内可直连）：https://api.siliconflow.cn/v1
# - OpenAI 官方：https://api.openai.com/v1
# - DeepSeek 官方：https://api.deepseek.com/v1
AI_BASE_URL="https://api.siliconflow.cn/v1"

# 模型名称（必填，需与服务商支持的模型对应）
# - 硅基流动可用：deepseek-ai/DeepSeek-V3, Qwen/Qwen2.5-72B-Instruct
# - OpenAI 可用：gpt-4o, gpt-4o-mini
# - DeepSeek 官方：deepseek-chat
AI_MODEL="deepseek-ai/DeepSeek-V3"

# ============================================================
# 静态资源 / 上传（Phase 5 备用）
# ============================================================
UPLOAD_DIR="./uploads"
