# ============================================================
# 数据库配置
# ============================================================
DATABASE_URL="mysql://root:root@localhost:3306/jiaoyu"

# ============================================================
# 服务端配置
# ============================================================
PORT=3000
NODE_ENV="development"

# 跨域白名单，多个地址用逗号分隔，* 表示允许所有
CORS_ORIGIN="http://localhost:5173"

# ============================================================
# 安全鉴权（管理端接口使用）
# ============================================================
ADMIN_JWT_SECRET="change-me-to-a-strong-admin-jwt-secret"
ADMIN_BOOTSTRAP_EMAIL="admin@openedu.local"
ADMIN_BOOTSTRAP_PASSWORD="change-me-admin-password"
ADMIN_BOOTSTRAP_NAME="系统管理员"

# ============================================================
# JWT 密钥（学生登录注册使用）
# ============================================================
JWT_SECRET="change-me-to-a-strong-jwt-secret"

# ============================================================
# AI 服务配置
# 支持任何兼容 OpenAI Chat Completions 格式的服务商
# ============================================================

# 生成式 AI 是可选增强。论文演示默认关闭，不配置密钥也能运行核心问答。
AI_ENABLED="false"
OPENAI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL=""

# ============================================================
# 静态资源 / 上传（Phase 5 备用）
# ============================================================
UPLOAD_DIR="./uploads"

# ============================================================
# 教务数据集成
# mock：显式演示数据；external：连接机构现有教务 API
# ============================================================
EDU_DATA_PROVIDER="mock"
EDU_API_BASE_URL=""
EDU_API_KEY=""
EDU_API_TIMEOUT_MS="8000"
EDU_API_RETRY_COUNT="1"
